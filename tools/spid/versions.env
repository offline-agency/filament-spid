# Pinned tools for the local SPID lab (tools/spid) and the spid-validation
# workflow. Observed 2026-10-11; update deliberately, then rerun the lab.

# italia/spid-sp-test (PyPI spid-sp-test), tag v1.2.18 = 32ac4e7ee819d140bca69e91d8626d6f7d98d364.
# filament-spid:metadata:validate refuses any other version.
SPID_SP_TEST_VERSION=1.2.18

# Base image of the spid-sp-test container (multi-arch: amd64, arm64).
PYTHON_IMAGE=python:3.11-slim-bookworm@sha256:0a310eeecf4e1f5a0743f9a6520c90c88d089c903ca5fd283f501e3a805f5f89

# italia/spid-saml-check v.2.2.5 (commit 60523977747a56005d807c2a22d4ad16f459329e).
# linux/amd64 only: on arm64 hosts it runs under emulation.
SPID_SAML_CHECK_IMAGE=italia/spid-saml-check:2.2.5@sha256:46db12d254ce1aacc592891104093107e108cb7953f9b4f6b2009e0522a6fdb9
