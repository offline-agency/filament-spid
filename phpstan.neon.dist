parameters:
    level: 8
    paths:
        - src
        - config
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    # The only model is the application's configurable user model, whose
    # columns are unknown here.
    checkModelProperties: false
    scanFiles:
        # The application's App\Models\User, which the package defaults to.
        - tests/stubs/App/Models/User.php
    ignoreErrors:
        # Larastan only recognises the application's config_path(); env() in
        # the package's own config file is read before config is cached.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/filament-spid.php
