# filament-spid: every variable here is read by config/filament-spid.php.
# No secret belongs in it: the SP key pair is referenced by path in
# config/spid-auth.php (sp_certificate_file, sp_private_key_file).

# The panel SPID logins land on (required with more than one panel).
FILAMENT_SPID_PANEL=admin

# Create accounts for SPID citizens without one (they still need canAccessPanel()).
SPID_AUTO_CREATE_USERS=false

# public or private: the spid_sp_test profile of filament-spid:metadata:validate.
FILAMENT_SPID_SP_PROFILE=public

# local, acceptance or production: which test IdPs the doctor expects.
FILAMENT_SPID_DEPLOYMENT=production

# Lowest SPID level accepted (default SpidL2).
# FILAMENT_SPID_MINIMUM_LEVEL=https://www.spid.gov.it/SpidL2

# Keep SPID attributes in users.spid_data (see spid_data_attributes).
# FILAMENT_SPID_STORE_SPID_DATA=true

# spid_sp_test executable for filament-spid:metadata:validate.
# SPID_SP_TEST_BIN=spid_sp_test

# The SPID session must not travel in clear.
SESSION_SECURE_COOKIE=true
