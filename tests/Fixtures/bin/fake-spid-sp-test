#!/usr/bin/env bash
# Stand-in for spid_sp_test in the adapter's error-path tests. Behaviour is
# chosen with FAKE_SPID_SP_TEST; the real tool is exercised by the
# integration test (tests/Integration).
set -u
mode="${FAKE_SPID_SP_TEST:-pass}"
if [ "${1:-}" = "--version" ]; then
    [ "$mode" = "old" ] && echo "1.2.17" || echo "1.2.18"
    exit 0
fi
report=""
while [ $# -gt 0 ]; do
    if [ "$1" = "-o" ]; then report="$2"; shift; fi
    if [ "$1" = "--metadata-url" ] && [ -n "${FAKE_SPID_SP_TEST_ARGS:-}" ]; then cp "${2#file://}" "$FAKE_SPID_SP_TEST_ARGS.metadata"; fi
    echo "$1" >> "${FAKE_SPID_SP_TEST_ARGS:-/dev/null}"
    shift
done
entry() { printf '{"test_id": "%s", "test": "%s", "value": "%s", "references": ["TR pag. 20"], "method": "%s", "result": "%s"}' "$1" "$2" "$3" "$1" "$4"; }
case "$mode" in
    pass)
        printf '{"test": {"sp": {"metadata_extra": {"SpidSpMetadataCheckExtra": [%s, %s]}}}}' "$(entry test_EntityDescriptor 'the entityID MUST be present' '' success)" "$(entry test_Organization 'Organization SHOULD be present' 'missing' warning)" > "$report"
        echo "Spid QA: executed 2 tests, 0 failed. 1 warnings."; exit 0 ;;
    clean)
        printf '{"test": {"sp": {"metadata_extra": {"SpidSpMetadataCheckExtra": [%s]}}}}' "$(entry test_EntityDescriptor 'the entityID MUST be present' '' success)" > "$report"
        echo "Spid QA: executed 1 tests, 0 failed. 0 warnings."; exit 0 ;;
    fail)
        printf '{"test": {"sp": {"metadata_extra": {"SpidSpMetadataCheckExtra": [%s, %s]}}}}' "$(entry test_EntityDescriptor 'the entityID MUST be present' '' success)" "$(entry test_Signature 'the metadata signature MUST be valid' 'invalid signature' failure)" > "$report"
        echo "Spid QA: executed 2 tests, 1 failed. 0 warnings."; exit 1 ;;
    exit1clean)
        printf '{"test": {"sp": {"metadata_extra": {"SpidSpMetadataCheckExtra": [%s]}}}}' "$(entry test_EntityDescriptor 'the entityID MUST be present' '' success)" > "$report"; exit 1 ;;
    lying)
        printf '{"test": {"sp": {"metadata": {"SpidSpMetadataCheck": [%s]}}}}' "$(entry test_Signature 'the metadata signature MUST be valid' 'invalid' failure)" > "$report"; exit 0 ;;
    dependency)
        printf '{"test": {"sp": {"metadata_extra": {"SpidSpMetadataCheckExtra": [%s]}}}}' "$(entry '' 'the metadata signature MUST be valid' 'stderr: /bin/sh: None: command not found' failure)" > "$report"; exit 1 ;;
    empty) printf '{"test": {"sp": {}}}' > "$report"; exit 0 ;;
    malformed) printf 'not json' > "$report"; exit 0 ;;
    noreport) exit 0 ;;
    crash) echo "Traceback (most recent call last)" >&2; exit 3 ;;
    sleep) sleep 5; exit 0 ;;
esac
